# ===== 互动课堂后端配置 =====
# 复制本文件为 .env 后填写。.env 不会提交到 Git（见 .gitignore）。
#
# 部署形态：
#   - 本机开发（Windows）：MySQL 在本机 127.0.0.1，DB_PASSWORD 填你本机密码
#   - Ubuntu 服务器（整套部署）：MySQL 也装在这台服务器上，同样填 127.0.0.1 + 服务器 MySQL 密码
#     首次启动会自动建库建表（DB 账号需有建库权限，如 root）
#   - Ubuntu 的 MySQL 8 root 默认走 socket 认证，需先设密码并允许 127.0.0.1 登录，见 install.sh 顶部说明
NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# MySQL root 密码（本机或服务器都要改成实际密码）
DB_PASSWORD=change-me
DB_NAME=interactive_classroom

# JWT 签名密钥：务必改成随机长字符串！
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-change-me-please-use-a-long-random-secret
JWT_EXPIRES_IN=7d

# 前端域名：同源部署（后端托管前端，单端口）留空；跨域时才填前端地址
FRONTEND_ORIGIN=

# 反向代理：Node 直接暴露公网端口 → 留空/0；前面有 nginx / IIS / 云负载均衡 → 设 1
# （使登录限流能取到真实客户端 IP）
TRUST_PROXY=0

# Cookie 仅 HTTPS 发送：走 HTTPS → 设 1；纯 HTTP 测试 → 保持 0（否则登录态存不下来）
COOKIE_SECURE=0
ADMIN_USERNAMES=

# ===== 平台 AI（AI 辅导必填；每日挑战可共用）=====
# 密钥只放在服务器 .env 中，不得写入 app.js、HTML 或数据库用户记录。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 社区额外敏感词：英文逗号分隔。默认词表之外按学校运营要求追加。
COMMUNITY_BLOCKED_WORDS=
